<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="red_box">

    <static>true</static>

    <link name="box_link">

      <pose>0 0 0.25 0 0 0</pose>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 0.5 0.5</size>
          </box>
        </geometry>
        <material>
          <!-- Gazebo Classic material -->
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Red</name>
          </script>
          <!-- Fallback RGBA for rendering -->
          <ambient>0.8 0.0 0.0 1</ambient>
          <diffuse>0.8 0.0 0.0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0.2 0.0 0.0 1</emissive>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 0.5 0.5</size>
          </box>
        </geometry>
      </collision>

    </link>

  </model>
</sdf>
