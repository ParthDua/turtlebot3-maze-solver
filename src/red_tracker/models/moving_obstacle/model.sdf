<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="moving_obstacle">
    <static>false</static>

    <link name="link">
      <pose>0 0 0.25 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.3 0.3 0.5</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box><size>0.3 0.3 0.5</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.8 1</ambient>
          <diffuse>0.1 0.1 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- planar_move: drives the model via a Twist on /obstacle/cmd_vel -->
    <plugin name="obstacle_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/obstacle</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>20</update_rate>
      <publish_rate>20</publish_rate>
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>obstacle_odom</odometry_frame>
      <robot_base_frame>link</robot_base_frame>
    </plugin>

  </model>
</sdf>
